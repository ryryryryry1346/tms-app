# --- Database ---
MYSQL_DATABASE_URL=mysql://root:password@127.0.0.1:3306/tms_app

# --- Runtime ---
NODE_ENV=production

# --- Auth (better-auth) ---
# REQUIRED in production. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# REQUIRED in production. Public base URL of the app; used to build
# verification and password-reset links. No trailing slash.
BETTER_AUTH_URL=https://tms.example.com

# --- Email ---
# Needed for password reset / email verification links.
# MAIL_DRIVER: smtp | resend | log
#   smtp   - company mail server (SMTP_* below)
#   resend - Resend API (RESEND_API_KEY)
#   log    - nothing is sent, the message with its link goes to the server
#            log (closed setup without a mail server; admin forwards links)
# If MAIL_DRIVER is not set: resend when RESEND_API_KEY is set, otherwise
# smtp when SMTP_HOST is set.
MAIL_DRIVER=smtp
# Sender shown on emails (for Resend it must be a verified domain).
MAIL_FROM=TMS <no-reply@example.com>

# SMTP (MAIL_DRIVER=smtp)
SMTP_HOST=mail.example.com
# 587 = STARTTLS (default), 465 = TLS from the start, 25 = plain/STARTTLS
SMTP_PORT=587
# Optional: force TLS on connect (default: true only for port 465)
# SMTP_SECURE=false
# Leave empty if the server accepts mail from this host without login.
SMTP_USER=
SMTP_PASSWORD=
# Only for an internal mail server whose certificate this machine
# does not trust:
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Resend (MAIL_DRIVER=resend)
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM is still accepted as a fallback for MAIL_FROM.

# --- Media uploads (images / videos in test cases and run results) ---
# STORAGE_DRIVER: local | cloudinary
#   local      - files are stored on this server's disk and served at
#                /api/media/... to signed-in users only
#   cloudinary - Cloudinary (CLOUDINARY_* below)
# If not set: cloudinary when it is configured, otherwise local.
STORAGE_DRIVER=local
# Where local uploads are stored (default: ./storage/media under web/).
# Use an absolute path on a server and include it in backups.
MEDIA_STORAGE_DIR=/var/lib/tms/media

# Cloudinary (STORAGE_DRIVER=cloudinary)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Optional explicit Cloudinary variables instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --- Integrations (Shortcut) ---
# REQUIRED to save per-project integration settings (Project > Settings >
# Integrations): encrypts the stored API tokens. Must be a dedicated secret,
# NOT the same value as BETTER_AUTH_SECRET, and must never be lost (saved
# tokens cannot be decrypted without it). Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-value

# Optional server-wide Shortcut fallback, used only by projects that have no
# Shortcut settings saved in the UI:
# SHORTCUT_API_TOKEN=your-shortcut-api-token
# SHORTCUT_WORKFLOW_STATE_ID=500000000
# SHORTCUT_GROUP_ID=
# SHORTCUT_LABEL_NAME=tms
# SHORTCUT_STORY_TYPE=chore

# --- Sign in with Slack (optional) ---
# Create a Slack app at https://api.slack.com/apps, add the redirect URL
# <BETTER_AUTH_URL>/api/auth/callback/slack and the user token scopes
# openid, email, profile. Without the two values below the button is hidden.
# SLACK_CLIENT_ID=1234567890.1234567890
# SLACK_CLIENT_SECRET=your-slack-client-secret
# Workspace id (T...): only this workspace can sign in. Required in production
# while SLACK_ALLOW_SIGN_UP is on.
# SLACK_TEAM_ID=T01AB2CD3EF
# Shown under the button ("Workspace: Acme"):
# SLACK_WORKSPACE_NAME=Acme
# true (default): new people from the workspace get a TMS account on first
# sign-in; false: Slack works only for existing accounts.
# SLACK_ALLOW_SIGN_UP=true
